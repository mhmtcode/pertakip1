<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             xmlns:cam="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui.Camera"
             x:Class="pertakip1.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F4F7FA">

    <Grid RowDefinitions="Auto, *, Auto">
        <cam:CameraView x:Name="Cam" Grid.Row="2"
                        WidthRequest="1" HeightRequest="1"
                        HorizontalOptions="Start" VerticalOptions="Start"
                        InputTransparent="True" />


        <!-- ================= 1. ÜST BAR (HEADER) ================= -->
        <Border StrokeThickness="0" Padding="10,8">
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="20,15">
                <!-- Logo ve Şirket Adı -->
                <HorizontalStackLayout Grid.Column="0" Spacing="12" VerticalOptions="Center">
                    <!-- Şirket Logosu -->
                    <Image Source="mevlana_logo.png" WidthRequest="70" HeightRequest="70" VerticalOptions="Center" />
                    <!-- Şirket İsmi -->
                    <Label Text="Alara Restorant Beeck GmbH." 
       FontSize="28" 
       FontAttributes="Bold" 
       TextColor="#2C3E50" 
       VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <!-- Sağ Ayarlar İkonu (15x15 Kesin Boyut) -->
                <Image Grid.Column="2" 
   Source="settings.png" 
   WidthRequest="30" 
   HeightRequest="30"
   Aspect="AspectFit"                   
   VerticalOptions="Center"
   HorizontalOptions="End">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSettingsClicked" />
                    </Image.GestureRecognizers>
                </Image>
            </Grid>
        </Border>
        

        <!-- ================= 2. ORTA İÇERİK ALANI ================= -->
        <Grid Grid.Row="1" ColumnDefinitions="2*, 4*, 2*"> 
            <!-- ORTA ALAN: PIN Giriş & Numaratör -->
            <VerticalStackLayout Grid.Column="1" 
                                 VerticalOptions="Center" 
                                 HorizontalOptions="Center" 
                                 Spacing="12">

                <!-- Başlıklar -->
                <Label Text="Guten Abend!" 
                       FontSize="38" 
                       FontAttributes="Bold" 
                       TextColor="#202F58" 
                       HorizontalOptions="Center"/>

                <Label Text="Bitte geben Sie 5 stellige PIN ein um loszulegen:" 
                       FontSize="20" 
                       TextColor="#5A6B82" 
                       HorizontalOptions="Center"/>

                <!-- PIN Gösterge Halka İndikatörleri (5 Adet Halka) -->
                <HorizontalStackLayout x:Name="PinDots" HorizontalOptions="Center" Spacing="12" Margin="0,5,0,15">
                    <Ellipse WidthRequest="18" HeightRequest="18" Stroke="#3A506B" StrokeThickness="2" Fill="Transparent"/>
                    <Ellipse WidthRequest="18" HeightRequest="18" Stroke="#3A506B" StrokeThickness="2" Fill="Transparent"/>
                    <Ellipse WidthRequest="18" HeightRequest="18" Stroke="#3A506B" StrokeThickness="2" Fill="Transparent"/>
                    <Ellipse WidthRequest="18" HeightRequest="18" Stroke="#3A506B" StrokeThickness="2" Fill="Transparent"/>
                    <Ellipse WidthRequest="18" HeightRequest="18" Stroke="#3A506B" StrokeThickness="2" Fill="Transparent"/>
                </HorizontalStackLayout>

                <!-- Keypad (Numaralar) Grid'i -->
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" 
                      ColumnDefinitions="Auto,Auto,Auto" 
                      RowSpacing="12" 
                      ColumnSpacing="12" 
                      HorizontalOptions="Center">                   

                    <!-- Satır 1 -->
                    <Button Grid.Row="0" Grid.Column="0" Text="1" Clicked="OnNumberClicked" Style="{StaticResource yeniTasarimButton}"/>
                    <Button Grid.Row="0" Grid.Column="1" Text="2" Clicked="OnNumberClicked" Style="{StaticResource yeniTasarimButton}"/>
                    <Button Grid.Row="0" Grid.Column="2" Text="3" Clicked="OnNumberClicked" Style="{StaticResource yeniTasarimButton}"/>

                    <!-- Satır 2 -->
                    <Button Grid.Row="1" Grid.Column="0" Text="4" Clicked="OnNumberClicked" Style="{StaticResource yeniTasarimButton}"/>
                    <Button Grid.Row="1" Grid.Column="1" Text="5" Clicked="OnNumberClicked" Style="{StaticResource yeniTasarimButton}"/>
                    <Button Grid.Row="1" Grid.Column="2" Text="6" Clicked="OnNumberClicked" Style="{StaticResource yeniTasarimButton}"/>

                    <!-- Satır 3 -->
                    <Button Grid.Row="2" Grid.Column="0" Text="7" Clicked="OnNumberClicked" Style="{StaticResource yeniTasarimButton}"/>
                    <Button Grid.Row="2" Grid.Column="1" Text="8" Clicked="OnNumberClicked" Style="{StaticResource yeniTasarimButton}"/>
                    <Button Grid.Row="2" Grid.Column="2" Text="9" Clicked="OnNumberClicked" Style="{StaticResource yeniTasarimButton}"/>

                    <!-- Satır 4 -->
                    <!-- Temizleme (C) Butonu (Kırmızı / Mercan Rengi) -->
                    <Button Grid.Row="3" Grid.Column="0" Text="C" TextColor="White" Clicked="OnClearClicked" Style="{StaticResource KeypadClearButtonStyle}"/>

                    <Button Grid.Row="3" Grid.Column="1" Text="0" Clicked="OnNumberClicked" Style="{StaticResource yeniTasarimButton}"/>

                    <!-- Silme / Backspace Butonu (Açık Mavi / Gri Rengi) -->
                    <ImageButton Grid.Row="3" Grid.Column="2"                                  
                                 BackgroundColor="#DDE7F0" 
                                 CornerRadius="10" 
                                 WidthRequest="90" 
                                 HeightRequest="55" />
                </Grid>
            </VerticalStackLayout>

            <!-- SAĞ ALAN: Saat İkonu ve Slogan -->
            <VerticalStackLayout Grid.Column="2" 
                                 VerticalOptions="Center" 
                                 HorizontalOptions="Center" 
                                 Spacing="15">
                <!-- Saat İllüstrasyonu -->
                <Image Source="shield.png" WidthRequest="100" HeightRequest="100"/>

                <Label Text="Gemeinsam&#10;mehr erreichen." 
                       FontSize="16" 
                       TextColor="#4A6572" 
                       HorizontalTextAlignment="Center" 
                       FontAttributes="Bold"/>

                <!-- Alt Mavi Çizgi Detayı -->
                <BoxView WidthRequest="30" HeightRequest="3" Color="#4A90E2" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>


        <!-- ================= 3. ALT DURUM BARI (FOOTER) ================= -->
        <Border Grid.Row="2" BackgroundColor="#E8EFF5" StrokeThickness="0" Padding="15,8">
            <Grid ColumnDefinitions="Auto, *, Auto">

                <!-- Bağlantı Durumu -->
                <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                    <Ellipse x:Name="connetionStatus" WidthRequest="10" HeightRequest="10" Fill="#2ECC71"/>
                    <Label Text="Internet:" FontSize="12"/>
                    <Label x:Name="internetConnectionLabel" TextColor="#27AE60" FontSize="12" FontAttributes="Bold"/>
                    <Label Text="|" TextColor="#BDC3C7" Margin="10,0"/>

                    <Label Text="Letzte Synchronisierung: " FontSize="12" FontAttributes="Bold"/>
                    <Label Text="01.01.2026 16:12"  FontSize="12"/>
                </HorizontalStackLayout>
                
            </Grid>
        </Border>


        <!-- ===== YENİ: Sonuç Popup Overlay ===== -->
        <Grid
            x:Name="ResultOverlay"
            Grid.RowSpan="3"
            IsVisible="False"
            BackgroundColor="#80000000">

            <Border
                x:Name="ResultFrame"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="300"
                HeightRequest="110"
                Padding="0"
                >
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="20">
                    <Image x:Name="DebugPhoto" IsVisible="False" Grid.Column="0"
                           WidthRequest="100" HeightRequest="100"/>
                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="5"
                        Grid.Column="1">
                        <Label
                            x:Name="ResultText"
                            Text="Erfolgreich"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalOptions="Center" />
                        <Label 
                            x:Name="ResultStatus"
                            TextColor="White" 
                            HorizontalOptions="Center" 
                            FontAttributes="Italic"/>
                    </VerticalStackLayout>
                </Grid>
                
                    

                  
               

            </Border>
        </Grid>

    </Grid>

</ContentPage>
